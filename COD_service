#!/bin/sh
# ==============================================================================
# 4-TIER SERVICE CONTROLLER (IMPROVED)
# ==============================================================================
SCRIPTS="cod_watcher.sh cod_geo_scanner.sh cod_promoter.sh cod_volume_filter.sh"

case "$1" in
    start)
        echo "[*] Starting COD pipelines..."
        for s in $SCRIPTS; do
            if ! pgrep -f "$s" >/dev/null 2>&1; then
                /root/$s >/dev/null 2>&1 &
                echo "  + $s"
            else
                echo "  = $s already running"
            fi
        done
        echo "[+] Start complete."
        ;;
    stop)
        echo "[*] Stopping COD pipelines..."
        for s in $SCRIPTS; do
            pgrep -f "$s" | xargs -r kill 2>/dev/null
            sleep 0.3
            pgrep -f "$s" | xargs -r kill -9 2>/dev/null
        done
        echo "[+] Stopped."
        ;;
    restart)
        $0 stop
        sleep 1
        $0 start
        ;;
    status)
        echo "================================================================================"
        echo "                 COD PIPELINE STATUS"
        echo "================================================================================"
        for s in $SCRIPTS; do
            pids=$(pgrep -f "$s" | tr '\n' ' ')
            if [ -n "$pids" ]; then
                printf "  %-22s : ONLINE  (PID: %s)\n" "$s" "$pids"
            else
                printf "  %-22s : OFFLINE\n" "$s"
            fi
        done
        echo "================================================================================"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
