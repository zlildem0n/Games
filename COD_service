#!/bin/sh
# ==============================================================================
# SCRIPT 11: REORDERED 4-TIER BACKGROUND SERVICE DAEMON CONTROLLER (BETA 3.0)
# ==============================================================================
case "$1" in
    start)
        echo "[*] Initializing Call of Duty 5-Stage Pipelines..."
        /root/cod_watcher.sh >/dev/null 2>&1 &
        /root/cod_geo_scanner.sh >/dev/null 2>&1 &
        /root/cod_promoter.sh >/dev/null 2>&1 &
        /root/cod_volume_filter.sh >/dev/null 2>&1 &
        echo "[+] All background pipelines running safely ONLINE."
        ;;
    stop)
        echo "[*] Terminating Call of Duty Background Daemons..."
        pgrep -f "cod_watcher.sh" | xargs kill -9 2>/dev/null
        pgrep -f "cod_geo_scanner.sh" | xargs kill -9 2>/dev/null
        pgrep -f "cod_promoter.sh" | xargs kill -9 2>/dev/null
        pgrep -f "cod_volume_filter.sh" | xargs kill -9 2>/dev/null
        echo "[+] System background spaces cleared."
        ;;
    restart)
        $0 stop && sleep 1 && $0 start
        ;;
    status)
        echo "================================================================================"
        echo "            📋 SYSTEM CORE CONSOLE WORKING SERVICE METRICS MATRIX"
        echo "================================================================================"
        pid_w=$(pgrep -f "cod_watcher.sh" | tr '\n' ' ')
        pid_g=$(pgrep -f "cod_geo_scanner.sh" | tr '\n' ' ')
        pid_p=$(pgrep -f "cod_promoter.sh" | tr '\n' ' ')
        pid_v=$(pgrep -f "cod_volume_filter.sh" | tr '\n' ' ')
        printf "  cod_watcher.sh       : %s (PID: %s)\n" "${pid_w:+ONLINE}${pid_w:-OFFLINE}" "${pid_w:-N/A}"
        printf "  cod_geo_scanner.sh   : %s (PID: %s)\n" "${pid_g:+ONLINE}${pid_g:-OFFLINE}" "${pid_g:-N/A}"
        printf "  cod_promoter.sh      : %s (PID: %s)\n" "${pid_p:+ONLINE}${pid_p:-OFFLINE}" "${pid_p:-N/A}"
        printf "  cod_volume_filter.sh : %s (PID: %s)\n" "${pid_v:+ONLINE}${pid_v:-OFFLINE}" "${pid_v:-N/A}"
        echo "================================================================================"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
