#!/bin/sh
# ==============================================================================
# SCRIPT 8: CENTRALIZED MONITORING COMMAND CONSOLE DASHBOARD (WITH STATUS PANEL)
# ==============================================================================

# Define absolute file matrix targets matching your storage exactly
DUMP="/root/COD_Dump.txt"
PRE_PENDING="/root/COD_Pre_Pending.txt"
PENDING="/root/COD_Pending.txt"
POST_PENDING="/root/COD_Post_Pending.txt"
BLOCKED="/root/COD_Blocked.txt"
UNPINGABLE="/root/COD_Unpingable.txt"
OFFICIAL="/root/COD_Official_Allowed.txt"
MASTER="/root/COD_Master.txt"

# Clear terminal screen completely before starting the engine layout
clear

while true; do
    # Jump back to the top-left terminal coordinates to avoid scrolling lag
    printf "\033[H"
    
    # Calculate unique row lines inside each tracking file container safely
    cnt_dump=$(wc -l "$DUMP" 2>/dev/null | awk '{print $1}')
    cnt_pre=$(wc -l "$PRE_PENDING" 2>/dev/null | awk '{print $1}')
    cnt_pend=$(wc -l "$PENDING" 2>/dev/null | awk '{print $1}')
    cnt_post=$(wc -l "$POST_PENDING" 2>/dev/null | awk '{print $1}')
    cnt_block=$(wc -l "$BLOCKED" 2>/dev/null | awk '{print $1}')
    cnt_unping=$(wc -l "$UNPINGABLE" 2>/dev/null | awk '{print $1}')
    cnt_off=$(wc -l "$OFFICIAL" 2>/dev/null | awk '{print $1}')
    cnt_mast=$(wc -l "$MASTER" 2>/dev/null | awk '{print $1}')

    # Check background process IDs to determine active state
    pid_watch=$(pgrep -f "/root/cod_watcher.sh" | tr '\n' ' ')
    pid_prom=$(pgrep -f "/root/cod_promoter.sh" | tr '\n' ' ')
    pid_fail=$(pgrep -f "/root/cod_failsafe.sh" | tr '\n' ' ')

    if [ -n "$pid_watch" ] && [ "$pid_watch" != " " ]; then stat_watch="\033[0;32mONLINE\033[0m"; else stat_watch="\033[0;31mOFFLINE\033[0m"; fi
    if [ -n "$pid_prom" ] && [ "$pid_prom" != " " ]; then stat_prom="\033[0;32mONLINE\033[0m"; else stat_prom="\033[0;31mOFFLINE\033[0m"; fi
    if [ -n "$pid_fail" ] && [ "$pid_fail" != " " ]; then stat_fail="\033[0;32mONLINE\033[0m"; else stat_fail="\033[0;31mOFFLINE\033[0m"; fi

    echo "================================================================================"
    echo "         🛡️  CALL OF DUTY HIGH-SPEED GAME SERVER MONITORING CONSOLE 🛡️          "
    echo "================================================================================"
    echo " TIME SNAPSHOT : $(date '+%Y-%m-%d %H:%M:%S')"
    echo "--------------------------------------------------------------------------------"
    echo "  ⚙️  BACKGROUND DAEMON RUN-STATES:"
    printf "  • Watcher Sniper Engine : %s\n" "$stat_watch"
    printf "  • Promoter /24 Engine   : %s\n" "$stat_prom"
    printf "  • Failsafe Sweep Engine : %s\n" "$stat_fail"
    echo "--------------------------------------------------------------------------------"
    echo "  [+] STAGE 1: Live Snipped Queue (COD_Dump.txt)          : ${cnt_dump:-0} IPs"
    echo "  [+] STAGE 2: Conntrack Verified (COD_Pre_Pending.txt)  : ${cnt_pre:-0} IPs"
    echo "  [+] STAGE 3: Converted Subnets (COD_Pending.txt)       : ${cnt_pend:-0} /24 Blocks"
    echo "--------------------------------------------------------------------------------"
    echo "  📊 VALIDATION MATRICES & PROMOTIONS:"
    printf "  🟢 Optimal Servers (<70ms)    (COD_Post_Pending.txt)    : \033[0;32m%s /24 Blocks\033[0m\n" "${cnt_post:-0}"
    printf "  ❌ High Latency Filter (>70ms) (COD_Blocked.txt)         : \033[0;31m%s /24 Blocks\033[0m\n" "${cnt_block:-0}"
    printf "  ⚠️  Firewalled/Dead Nodes      (COD_Unpingable.txt)      : \033[0;33m%s /24 Blocks\033[0m\n" "${cnt_unping:-0}"
    echo "--------------------------------------------------------------------------------"
    echo "  🛡️  MASTER WHITELISTS & GAME INFRASTRUCTURE:"
    echo "  🏢 Official Demonware Ports   (COD_Official_Allowed.txt): ${cnt_off:-0} Permanent"
    echo "  👑 Master Archived Footprints  (COD_Master.txt)          : ${cnt_mast:-0} Total Entries"
    echo "================================================================================"
    echo " Press [CTRL+C] to minimize console panel view safely."

    sleep 2
done
