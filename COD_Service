#!/bin/sh
# ==============================================================================
# COD SERVICE CONTROLLER - EXPLICIT PATH FRAMEWORK (V5.0)
# ==============================================================================
SCRIPTS="cod_watcher.sh cod_geo_scanner.sh cod_promoter.sh cod_volume_filter.sh"
RAW_URL="https://raw.githubusercontent.com/zlildem0n/Games/refs/heads/main"
TARGET="/root"

case "$1" in
    start)
        echo "[*] Starting COD unbuffered network pipelines..."
        
        # 1. Boot Stage 1 (Conntrack Engine Sniper) with strict string validation
        if ! pgrep -f "[c]od_watcher.sh" >/dev/null 2>&1; then
            /root/cod_watcher.sh >/dev/null 2>&1 &
            echo "  + cod_watcher.sh (Kernel State Sniper)"
            sleep 1
        else
            echo "  = cod_watcher.sh already running"
        fi

        # 2. Boot Remaining Filter and Promoter Automation Daemons safely
        for s in cod_geo_scanner.sh cod_promoter.sh cod_volume_filter.sh; do
            first_char=$(echo "$s" | cut -c1)
            rest_chars=$(echo "$s" | cut -c2-)
            pattern="[$first_char]$rest_chars"
            
            if ! pgrep -f "$pattern" >/dev/null 2>&1; then
                /root/$s >/dev/null 2>&1 &
                echo "  + $s"
                sleep 0.5
            else
                echo "  = $s already running"
            fi
        done
        echo "[+] Core pipeline engines initialized."
        ;;
    stop)
        echo "[*] Terminating COD background processing threads..."
        for s in $SCRIPTS; do
            pgrep -f "$s" | xargs -r kill 2>/dev/null
            sleep 0.2
            pgrep -f "$s" | xargs -r kill -9 2>/dev/null
        done
        echo "[+] Stopped."
        ;;
    restart)
        $0 stop
        sleep 1.5
        $0 start
        ;;
    status)
        echo "================================================================================"
        echo "                 COD PIPELINE METRICS RUN-STATES"
        echo "================================================================================"
        for s in $SCRIPTS; do
            first_char=$(echo "$s" | cut -c1)
            rest_chars=$(echo "$s" | cut -c2-)
            pattern="[$first_char]$rest_chars"
            
            pids=$(pgrep -o -f "$pattern" | tr '\n' ' ')
            if [ -n "$pids" ]; then
                printf "  %-22s : ONLINE  (PID: %s)\n" "$s" "$pids"
            else
                printf "  %-22s : OFFLINE\n" "$s"
            fi
        done
        echo "================================================================================"
        ;;
    update)
        echo "[*] Syncing frameworks from remote GitHub main branch..."
        
        # IRONCLAD FIXED PATH: Pointing directly to your raw branch block layout
        echo "  → COD_IPS (Updating Hardware Block Matrix Layer)"
        curl -k -sSL "${RAW_URL}/COD_IPS" -o "${TARGET}/COD_Hardware_Blocks" && chmod 644 "${TARGET}/COD_Hardware_Blocks"

        # Core pipeline scripts
        for f in cod_watcher.sh cod_geo_scanner.sh cod_promoter.sh cod_volume_filter.sh cod_blocked_review.sh; do
            echo "  → $f"
            curl -k -sSL "${RAW_URL}/${f}" -o "${TARGET}/${f}" && chmod 755 "${TARGET}/${f}"
        done

        # Control scripts
        for f in COD_Service COD_Dashboard COD_Geo_Updater; do
            echo "  → $f"
            curl -k -sSL "${RAW_URL}/${f}" -o "${TARGET}/${f}" && chmod 755 "${TARGET}/${f}"
        done

        # Allowed configurations list
        echo "  → COD_States"
        if curl -k -sSL "${RAW_URL}/COD_States" -o "${TARGET}/COD_States.new" && [ -s "${TARGET}/COD_States.new" ]; then
            mv -f "${TARGET}/COD_States.new" "${TARGET}/COD_States"
            chmod 644 "${TARGET}/COD_States"
        fi

        rm -f /root/COD_Updater /root/COD_dashboard /root/COD_service /root/COD_updater /root/cod_failsafe.sh 2>/dev/null
        echo "[SUCCESS] All system tracking modules and IP blocks completely refreshed."
        ;;
    update-geo)
        /root/COD_Geo_Updater
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status|update|update-geo}"
        exit 1
        ;;
esac
