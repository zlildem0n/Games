#!/bin/sh
# ==============================================================================
# SCRIPT 2: MAILBOX QUEUE PROCESSOR (CLEAN STAGING HANDOFF)
# ==============================================================================
MAX_LATENCY=70
LOCK_FILE="/tmp/cod_verify.lock"
DUMP_FILE="/root/COD_Dump.txt"
PASSED_POOL="/root/COD_Pending.txt"
BLOCKED_POOL="/root/COD_Blocked.txt"
UNPING_POOL="/root/COD_Unpingable.txt"
MASTER_FILE="/root/COD_Master.txt"
PROMOTER_SCRIPT="/root/cod_promoter.sh"

_new_pass=0

while [ -s "$DUMP_FILE" ]; do
    _queue="/tmp/cod_verify_queue.txt"
    mv "$DUMP_FILE" "$_queue" && touch "$DUMP_FILE"
    WAN_IP=$(ip -4 route get 1.1.1.1 2>/dev/null | grep -oE 'src [0-9.]+' | awk '{print $2}')
    [ -z "$WAN_IP" ] && WAN_IP=$(curl -4 -s --max-time 5 http://ifconfig.me 2>/dev/null)
    
    while read -r TARGET_IP; do
        [ -z "$TARGET_IP" ] && continue
        
        # 1. CORE MASTER AUTHENTICATION INFRASTRUCTURE EXCEPTION GATE
        case "$TARGET_IP" in
            185.34.107.*)
                echo "$TARGET_IP" >> "$PASSED_POOL"
                LABEL_TEXT="Pending"
                _new_pass=1
                sed -i "\|^$TARGET_IP|d" "$MASTER_FILE" 2>/dev/null
                echo "$TARGET_IP #$LABEL_TEXT" >> "$MASTER_FILE"
                continue
                ;;
        esac
        
        # 2. RUN HIGH-PRECISION LATENCY DIAGNOSTIC ROUND-TRIP SWEEPS
        PING_TIME=$(ping -4 -I "$WAN_IP" -c 2 -W 1 "$TARGET_IP" 2>/dev/null | grep avg | awk -F/ '{print $5}' | cut -d. -f1)
        if [ -z "$PING_TIME" ]; then
            GATEWAY_IP=$(echo "$TARGET_IP" | awk -F. '{print $1"."$2"."$3".1"}')
            PING_TIME=$(ping -4 -I "$WAN_IP" -c 2 -W 1 "$GATEWAY_IP" 2>/dev/null | grep avg | awk -F/ '{print $5}' | cut -d. -f1)
        fi
        
        LABEL_TEXT="Pending"
        if [ -n "$PING_TIME" ]; then
            if [ "$PING_TIME" -le "$MAX_LATENCY" ]; then
                # Escalate to standard processing pools
                echo "$TARGET_IP" >> "$PASSED_POOL"
                LABEL_TEXT="Pending"
                _new_pass=1
            else
                echo "$TARGET_IP" >> "$BLOCKED_POOL"
                LABEL_TEXT="Blocked"
            fi
        else
            echo "$TARGET_IP" >> "$UNPING_POOL"
            LABEL_TEXT="Unpingable"
        fi
        sed -i "\|^$TARGET_IP|d" "$MASTER_FILE" 2>/dev/null
        echo "$TARGET_IP #$LABEL_TEXT" >> "$MASTER_FILE"
    done < "$_queue"
    rm -f "$_queue"
done

for pool in Pending Blocked Unpingable Master; do
    target="/root/COD_${pool}.txt"
    [ -f "$target" ] && sort -u "$target" -o "$target"
done

rm -f "$LOCK_FILE"
if [ "$_new_pass" -eq 1 ] && [ -x "$PROMOTER_SCRIPT" ]; then
    "$PROMOTER_SCRIPT" &
fi


