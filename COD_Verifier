cat << 'EOF' > /root/cod_verify.sh
#!/bin/sh
# ==============================================================================
# SCRIPT 2: BUFFER MAILBOX PROCESSOR - FORCED PUBLIC IPV4 WAN AUDIT
# ==============================================================================

MAX_LATENCY=70
LOCK_FILE="/tmp/cod_verify.lock"
DUMP_FILE="/root/COD_Dump.txt"
PASSED_POOL="/root/COD_Pending.txt"
BLOCKED_POOL="/root/COD_Blocked.txt"
UNPING_POOL="/root/COD_Unpingable.txt"
MASTER_FILE="/root/COD_Master.txt"

# Cooldown check to prevent overlapping runs if Script 1 calls it repeatedly
if [ -f "$LOCK_FILE" ]; then exit 0; fi
touch "$LOCK_FILE"

# Process the dump file until it is completely empty
while [ -s "$DUMP_FILE" ]; do
    # Create a clean processing queue and empty the active landing pad mailbox
    _queue="/tmp/cod_verify_queue.txt"
    mv "$DUMP_FILE" "$_queue" && touch "$DUMP_FILE"
    
    # Extract ONLY your true, 4-octet Public IPv4 from the main routing table
    WAN_IP=$(ip -4 route get 1.1.1.1 2>/dev/null | grep -oE 'src [0-9.]+' | awk '{print $2}')
    [ -z "$WAN_IP" ] && WAN_IP=$(curl -4 -s --max-time 5 http://ifconfig.me 2>/dev/null)
    
    while read -r SUBNET; do
        [ -z "$SUBNET" ] && continue
        
        # Derive the target IP (.1 gateway host) of that subnet range
        TARGET_IP=$(echo "$SUBNET" | awk -F/ '{print $1}' | awk -F. '{print $1"."$2"."$3".1"}')
        
        # Fire 2 pure IPv4 pings bound directly to your outbound WAN interface link
        PING_TIME=$(ping -4 -I "$WAN_IP" -c 2 -W 1 "$TARGET_IP" 2>/dev/null | grep avg | awk -F/ '{print $5}' | cut -d. -f1)
        
        LABEL_TEXT="Pending"
        if [ -n "$PING_TIME" ]; then
            if [ "$PING_TIME" -le "$MAX_LATENCY" ]; then
                echo "   -> VERIFIED PASSED: $SUBNET ($PING_TIME ms). Staging to Pending."
                echo "$SUBNET" >> "$PASSED_POOL"
                LABEL_TEXT="Pending"
            else
                echo "   -> VERIFIED SLOW: $SUBNET ($PING_TIME ms). Staging to Blocked."
                echo "$SUBNET" >> "$BLOCKED_POOL"
                LABEL_TEXT="Blocked"
            fi
        else
            echo "   -> VERIFIED TIMEOUT: $SUBNET is unpingable. Staging to Unpingable."
            echo "$SUBNET" >> "$UNPING_POOL"
            LABEL_TEXT="Unpingable"
        fi
        
        # Update your central tracking Master directory with clean text comments
        sed -i "\|^$SUBNET|d" "$MASTER_FILE" 2>/dev/null
        echo "$SUBNET #$LABEL_TEXT" >> "$MASTER_FILE"
    done < "$_queue"
    rm -f "$_queue"
done

# Cleanly sort and deduplicate result text files instantly
for pool in Pending Blocked Unpingable Master; do
    target="/root/COD_${pool}.txt"
    [ -f "$target" ] && sort -u "$target" -o "$target"
done

# Enforce a 15-second gate lock cooldown before clearing the lock file
sleep 15
rm -f "$LOCK_FILE"
EOF
