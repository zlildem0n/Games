cat << 'EOF' > /root/cod_watcher.sh
#!/bin/sh
# ==============================================================================
# SCRIPT 1: STUN-TRIGGERED ENGINE - 50K EXPANDED EDGE WAN CONTEXT WATCHER
# ==============================================================================
XBOX_PORT="49806"
DUMP_FILE="/root/COD_Dump.txt"
MASTER_FILE="/root/COD_Master.txt"
WAN_IP="24.229.189.181"

touch "$DUMP_FILE" "$MASTER_FILE" && chmod 666 "$DUMP_FILE"

echo "[*] COD Sniper Active. Monitoring WAN edge interface eth4 smoothly..."

# YOUR EXPANDED FILTER: 
# Only pass traffic on port 49806 AND enforce your 30k-50k port range
# AND strictly isolate your 214-byte Call or 16-byte Answer size signature.
BPF_FILTER="udp and port $XBOX_PORT and \
(port 3074 or port 3544 or (udp[2:2] >= 30000 and udp[2:2] <= 50000) or (udp[0:2] >= 30000 and udp[0:2] <= 50000)) and \
(udp[11:2] == 16 or udp[11:2] == 214)"

while true; do
    # Force line-buffered mode (-l) to output clean matches instantly
    tcpdump -l -npi eth4 "$BPF_FILTER" 2>/dev/null | while read -r line; do
        
        # Pull out raw IP strings instantly
        EXTRACTED_IPS=$(echo "$line" | grep -oE '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}')
        [ -z "$EXTRACTED_IPS" ] && continue
        
        SERVER_IP=""
        for ip_check in $EXTRACTED_IPS; do
            # MODIFIED: Completely ignore your WAN IP, loopbacks, and local subnets
            if [ "$ip_check" != "$WAN_IP" ] && [ "$ip_check" != "0.0.0.0" ] && [ "$ip_check" != "127.0.0.1" ]; then
                SERVER_IP="$ip_check"
                break
            fi
        done
        [ -z "$SERVER_IP" ] && continue
        
        # Check against Master before appending to protect gateway flash storage
        if ! grep -q "^$SERVER_IP" "$MASTER_FILE" 2>/dev/null; then
            echo "$SERVER_IP" >> "$DUMP_FILE"
        fi
    done
    sleep 2
done
EOF
sed -i 's/\r//g' /root/cod_watcher.sh && chmod 755 /root/cod_watcher.sh


