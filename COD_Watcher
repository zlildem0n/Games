cat << 'EOF' > /root/cod_watcher.sh
#!/bin/sh
# ==============================================================================
# SCRIPT 1: STUN-TRIGGERED ENGINE - TWO-STAGE RE-ARRANGED FUNNEL WATCHER
# ==============================================================================
XBOX_PORT="49806"
DUMP_FILE="/root/COD_Dump.txt"
MASTER_FILE="/root/COD_Master.txt"

touch "$DUMP_FILE" && chmod 666 "$DUMP_FILE"

echo "[*] COD Funnel Watcher Active. Monitoring eth4 interface smoothly..."

# INFINITE WRAPPER: Automatically auto-reloads if a network layer drops
while true; do
    # STAGE 1: Wide-open capture of absolutely ANY packet using port 49806
    tcpdump -i eth4 -n -l "udp port $XBOX_PORT" 2>/dev/null | while read -r tripwire_packet; do
        
        # STAGE 2: Instantly narrow it down to ports 3074, 3544, or the 30000-45000 block
        # Checks if the packet contains any of your target gaming ports anywhere in the string
        IS_VALID_TARGET=0
        if echo "$tripwire_packet" | grep -qE "\.3074 |\.3544 "; then
            IS_VALID_TARGET=1
        else
            # Extract out the destination and source port numbers to evaluate the 30k-45k block range
            PORTS_FOUND=$(echo "$tripwire_packet" | grep -oE '\.[0-9]+' | tr -d '.' | tail -n 2)
            for p_num in $PORTS_FOUND; do
                if [ "$p_num" -ge 30000 ] && [ "$p_num" -le 45000 ]; then
                    IS_VALID_TARGET=1
                    break
                fi
            done
        fi
        
        # Drop the packet immediately if it doesn't match your target gaming ports
        [ "$IS_VALID_TARGET" -eq 0 ] && continue

        # Extract out the remote server IP address cleanly
        EXTRACTED_IPS=$(echo "$tripwire_packet" | grep -oE '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}')
        [ -z "$EXTRACTED_IPS" ] && continue
        
        SERVER_IP=""
        for ip_check in $EXTRACTED_IPS; do
            if [ "$ip_check" != "192.168.1.15" ] && [ "$ip_check" != "24.229.189.181" ] && [ "$ip_check" != "0.0.0.0" ]; then
                SERVER_IP="$ip_check"
                break
            fi
        done
        [ -z "$SERVER_IP" ] && continue
        
        # Safe-deposit verified match straight into your main Dump folder box
        if ! grep -q "^$SERVER_IP" "$MASTER_FILE" 2>/dev/null; then
            echo "$SERVER_IP" >> "$DUMP_FILE"
            sort -u "$DUMP_FILE" -o "$DUMP_FILE"
        fi
    done
    sleep 2
done
EOF
sed -i 's/\r//g' /root/cod_watcher.sh && chmod 755 /root/cod_watcher.sh

