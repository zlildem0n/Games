cat << 'EOF' > /root/cod_watcher.sh
#!/bin/sh
# ==============================================================================
# SCRIPT 1: STUN-TRIGGERED COD WATCHER - ETH4 PORT-ISOLATED BUILD
# ==============================================================================

XBOX_PORT="49806"
DUMP_FILE="/root/COD_Dump.txt"
VERIFY_SCRIPT="/root/cod_verify.sh"

touch "$DUMP_FILE"
chmod 666 "$DUMP_FILE"
echo "[*] COD Pinpoint Watcher Active. Monitoring eth4 via Port Isolation..."

# FIXED PIPELINE: Matches your exact working manual tcpdump filter structure over eth4
tcpdump -i eth4 -n -l "udp port $XBOX_PORT" 2>/dev/null | while read -r tripwire_packet; do
    
    # Surgical extraction of the true, literal 4-octet server address from the packet header
    SERVER_IP=$(echo "$tripwire_packet" | awk '{print $5}' | cut -d. -f1-4)
    [ -z "$SERVER_IP" ] && continue
    
    # Ignore internal LAN broadcast traffic or loops
    if [ "$SERVER_IP" != "192.168.1.15" ] && [ "$SERVER_IP" != "24.229.189.181" ]; then
        # Check if this exact individual host address is already cataloged in your master directory
        if ! grep -q "^$SERVER_IP" /root/COD_Master.txt 2>/dev/null; then
            echo "$SERVER_IP" >> "$DUMP_FILE"
            sort -u "$DUMP_FILE" -o "$DUMP_FILE"
            "$VERIFY_SCRIPT" &
        fi
    fi
done
EOF
chmod 755 /root/cod_watcher.sh
