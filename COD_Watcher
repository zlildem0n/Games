cat << 'EOF' > /root/cod_watcher.sh
#!/bin/sh
XBOX_PORT="49806"
# RENAMED: Shifted target file destination from COD_Dump to COD_US_Only
DUMP_FILE="/root/COD_US_Only.txt"
VERIFY_SCRIPT="/root/cod_verify.sh"
MASTER_FILE="/root/COD_Master.txt"
OFFICIAL_POOL="/root/COD_Official_Allowed.txt"
HIGH_LAT_POOL="/root/COD_Blocked.txt"
LOCK_FILE="/tmp/cod_verify.lock"

rm -f "$LOCK_FILE"
touch "$DUMP_FILE" && chmod 666 "$DUMP_FILE"
trap "wait" CHLD

echo "[*] COD Watcher Active. Monitoring traffic lanes safely..."

tcpdump -i eth4 -n -l "udp port $XBOX_PORT or port 3074 or port 3544" 2>/dev/null | while read -r tripwire_packet; do
    EXTRACTED_IPS=$(echo "$tripwire_packet" | grep -oE '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}')
    [ -z "$EXTRACTED_IPS" ] && continue
    
    SERVER_IP=""
    for ip_check in $EXTRACTED_IPS; do
        if [ "$ip_check" != "192.168.1.15" ] && [ "$ip_check" != "24.229.189.181" ] && [ "$ip_check" != "0.0.0.0" ]; then
            SERVER_IP="$ip_check"
            break
        fi
    done
    [ -z "$SERVER_IP" ] && continue
    
    if echo "$tripwire_packet" | grep -qE "\.3074|\.3544"; then
        VOTES_PASSED=0
        
        GEO_DATA=$(curl -s "https://freeipapi.com{SERVER_IP}" --max-time 2)
        [ "$(echo "$GEO_DATA" | grep -oE '"countryCode":"[^"]+"' | cut -d'"' -f4)" = "US" ] && VOTES_PASSED=$((VOTES_PASSED + 1))
        
        IPINFO_DATA=$(curl -s "https://ipinfo.io{SERVER_IP}/json" --max-time 2)
        [ "$(echo "$IPINFO_DATA" | grep -oE '"country": "[^"]+"' | cut -d'"' -f4)" = "US" ] && VOTES_PASSED=$((VOTES_PASSED + 1))

        SUBNET=$(echo "$SERVER_IP" | awk -F. '{print $1"."$2"."$3".0/24"}')
        if [ "$VOTES_PASSED" -ge 2 ]; then
            if ! grep -q "^$SUBNET" "$OFFICIAL_POOL" 2>/dev/null; then
                echo "$SUBNET" >> "$OFFICIAL_POOL"
                sed -i "\|^$SERVER_IP|d" "$MASTER_FILE" 2>/dev/null
                echo "$SUBNET #Official_Allowed" >> "$MASTER_FILE"
            fi
        else
            if ! grep -q "^$SERVER_IP" "$MASTER_FILE" 2>/dev/null; then
                echo "$SERVER_IP" >> "$HIGH_LAT_POOL"
                echo "$SERVER_IP #Blocked" >> "$MASTER_FILE"
            fi
        fi
        continue
    fi
    
    if ! grep -q "^$SERVER_IP" "$MASTER_FILE" 2>/dev/null; then
        echo "$SERVER_IP" >> "$DUMP_FILE"
        sort -u "$DUMP_FILE" -o "$DUMP_FILE"
        if [ ! -e "$LOCK_FILE" ]; then
            touch "$LOCK_FILE"
            "$VERIFY_SCRIPT" &
        fi
    fi
done
EOF
sed -i 's/\r//g' /root/cod_watcher.sh && chmod 755 /root/cod_watcher.sh

