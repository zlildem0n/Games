#!/bin/sh
# ==============================================================================
# SCRIPT 1: STUN-TRIGGERED ENGINE - 50K EXPANDED EDGE WAN CONTEXT WATCHER (FIXED)
# ==============================================================================
XBOX_PORT="49806"
DUMP_FILE="/root/COD_Dump.txt"
MASTER_FILE="/root/COD_Master.txt"
WAN_IP="24.229.189.181"

touch "$DUMP_FILE" "$MASTER_FILE" && chmod 666 "$DUMP_FILE"

echo "[*] COD Sniper Active. Monitoring WAN edge interface eth4 smoothly..."

# Strict primitive kernel filter targeting exact byte-length handshakes
BPF_FILTER="udp and port $XBOX_PORT and \
(port 3074 or port 3544 or (udp[2:2] >= 30000 and udp[2:2] <= 50000) or (udp[0:2] >= 30000 and udp[0:2] <= 50000)) and \
(udp[11:2] == 16 or udp[11:2] == 214)"

while true; do
    # Force line-buffered mode (-l) to output clean matches instantly
    tcpdump -l -npi eth4 "$BPF_FILTER" 2>/dev/null | while read -r line; do
        
        # Structurally parse out the source IP and destination IP using awk token blocks
        # This completely strips out the trailing port numbers (.49806) cleanly
        SRC_IP=$(echo "$line" | awk '{print $3}' | sed 's/\.[0-9]*$//')
        DST_IP=$(echo "$line" | awk '{print $5}' | sed 's/\.[0-9]*$//' | tr -d ':')
        
        SERVER_IP=""
        
        # Evaluate packet directionality relative to your edge WAN IP
        if [ "$SRC_IP" = "$WAN_IP" ]; then
            SERVER_IP="$DST_IP"
        elif [ "$DST_IP" = "$WAN_IP" ]; then
            SERVER_IP="$SRC_IP"
        fi
        
        # Safety catch for corrupted packet lines or loopbacks
        [ -z "$SERVER_IP" ] || [ "$SERVER_IP" = "0.0.0.0" ] || [ "$SERVER_IP" = "127.0.0.1" ] && continue
        
        # Quiet check against Master before appending to protect gateway flash storage
        if ! grep -q "^$SERVER_IP" "$MASTER_FILE" 2>/dev/null; then
            echo "$SERVER_IP" >> "$DUMP_FILE"
        fi
    done
    sleep 2
done
