cat << 'EOF' > /root/cod_geolocation.sh
#!/bin/sh
# ==============================================================================
# LIVE CLOUD-MAXMIND ENRICHMENT ENGINE - REAL-TIME DATABASE DISCOVERY
# ==============================================================================

MASTER_FILE="/root/COD_Master.txt"

if [ ! -s "$MASTER_FILE" ]; then
    echo "[!] Master tracking file is completely empty. No gaming footprints found."
    exit 0
fi

echo "--- LIVE CLOUD-MAXMIND GAME SERVER ROUTING MAP ---"
echo "================================================================================"
printf "%-16s | %-12s | %-28s | %s\n" "SERVER IP" "STATUS" "MAXMIND PHYSICAL ZONE" "DATA CENTER PROVIDER"
echo "--------------------------------------------------------------------------------"

while read -r line; do
    [ -z "$line" ] && continue
    
    # Isolate the exact individual server IP and its tracker category status tag
    IP_ADDR=$(echo "$line" | awk '{print $1}')
    STATUS_TAG=$(echo "$line" | awk '{print $2}')
    
    # Core STUN/Demonware auth bypass shortcut
    case "$IP_ADDR" in
        185.34.107.*)
            printf "📍 %-16s | %-12s | %-28s | %s\n" "$IP_ADDR" "$STATUS_TAG" "Santa Monica, California (US)" "Activision Master STUN [Demonware]"
            continue
            ;;
    esac
    
    # Query a high-fidelity live JSON API backed by dynamically updated MaxMind schemas
    GEO_DATA=$(curl -s "https://freeipapi.com{IP_ADDR}" --max-time 3)
    
    # Parse parameters cleanly using precise shell text extraction
    CITY=$(echo "$GEO_DATA" | grep -oE '"cityName":"[^"]+"' | cut -d'"' -f4)
    REGION=$(echo "$GEO_DATA" | grep -oE '"regionName":"[^"]+"' | cut -d'"' -f4)
    COUNTRY=$(echo "$GEO_DATA" | grep -oE '"countryCode":"[^"]+"' | cut -d'"' -f4)
    
    # Query a fallback ASN utility if the host provider name is clipped
    PROVIDER=$(curl -s "https://ipapi.co{IP_ADDR}/org/" --max-time 3 | tr -d '\r\n')
    [ -z "$PROVIDER" ] || echo "$PROVIDER" | grep -q "Undefined" && PROVIDER="Unknown Gaming Infrastructure"

    if [ -n "$CITY" ] && [ -n "$REGION" ]; then
        LOCATION_STRING="${CITY}, ${REGION} (${COUNTRY})"
        printf "📍 %-16s | %-12s | %-28s | [%s]\n" "$IP_ADDR" "$STATUS_TAG" "$LOCATION_STRING" "$PROVIDER"
    else
        printf "❌ %-16s | %-12s | %-28s | %s\n" "$IP_ADDR" "$STATUS_TAG" "Unknown Location Zone" "[Cloud Query Timeout]"
    fi
    
    # Polite 1-second delay to strictly respect cloud rate restrictions
    sleep 1
done < "$MASTER_FILE"
echo "================================================================================"
EOF
