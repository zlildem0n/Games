#!/bin/sh
# ==============================================================================
# AUTOMATED PIPELINE UPDATER (IMPROVED + BLOCKED REVIEWER)
# ==============================================================================
RAW_URL="https://raw.githubusercontent.com/zlildem0n/Games/main"
TARGET="/root"

echo "[*] Checking GitHub..."
if ! curl -k -s --connect-timeout 8 "$RAW_URL/COD_Updater" >/dev/null; then
    echo "[!] GitHub unreachable."
    exit 1
fi

echo "[*] Synchronizing scripts..."

# Core daemons
for f in cod_watcher.sh cod_geo_scanner.sh cod_promoter.sh cod_volume_filter.sh cod_blocked_review.sh; do
    curl -k -sSL "${RAW_URL}/${f}" -o "${TARGET}/${f}" && chmod 755 "${TARGET}/${f}"
done

# Control scripts
for f in COD_service COD_Dashboard COD_Geo_Updater COD_Updater; do
    curl -k -sSL "${RAW_URL}/${f}" -o "${TARGET}/${f}" && chmod 755 "${TARGET}/${f}"
done

# Config list
if curl -k -sSL "${RAW_URL}/COD_States" -o "${TARGET}/COD_States.new" && [ -s "${TARGET}/COD_States.new" ]; then
    mv -f "${TARGET}/COD_States.new" "${TARGET}/COD_States"
    chmod 644 "${TARGET}/COD_States"
fi

# Cleanup old names
rm -f /root/COD_dashboard /root/COD_service /root/COD_updater /root/cod_failsafe.sh 2>/dev/null

echo "[SUCCESS] All scripts updated."
