#!/bin/sh
# ==============================================================================
# SCRIPT 9: AUTOMATED REPOSITORY DEPLOYMENT & ARTIFACT SYNCHRONIZATION ENGINE
# ==============================================================================
REPO_OWNER="zlildem0n"
REPO_NAME="Games"
RELEASE_TAG="Beta-2.0"
TARGET_DIR="/root"
TMP_DIR="/tmp/github_update_$$"

URL="https://github.com{REPO_OWNER}/${REPO_NAME}/releases/download/${RELEASE_TAG}/Games.tar.gz"

if ! curl -s --connect-timeout 5 https://github.com > /dev/null; then
    exit 1
fi

mkdir -p "$TMP_DIR"
if curl -sSL "$URL" -o "${TMP_DIR}/Games.tar.gz"; then
    tar -xf "${TMP_DIR}/Games.tar.gz" -C "$TMP_DIR"
    
    # Extract shell scripts and compiled daemons cleanly
    find "$TMP_DIR" -type f \( -name "*.sh" -o -name "COD_service" -o -name "COD_dashboard" -o -name "COD_Geo_Updater" \) | while read -r src_file; do
        fname=$(basename "$src_file")
        mv -f "$src_file" "${TARGET_DIR}/${fname}"
        chmod 755 "${TARGET_DIR}/${fname}"
    done
    
    # CRITICAL FIX: Explicitly look for and copy your raw configuration list
    if [ -f "${TMP_DIR}/COD_States" ]; then
        mv -f "${TMP_DIR}/COD_States" "${TARGET_DIR}/COD_States"
        chmod 644 "${TARGET_DIR}/COD_States"
        echo "[+] Successfully synchronized dynamic config file: COD_States"
    fi
    
    rm -rf "$TMP_DIR"
else
    rm -rf "$TMP_DIR"
    exit 1
fi
