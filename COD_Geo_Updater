#!/bin/sh
# ==============================================================================
# MAXMIND GEOLITE2 CITY UPDATER (Always latest)
# Downloads to /root/GeoLite2-City.mmdb
# ==============================================================================
GEO_URL="https://github.com/P3TERX/GeoLite.mmdb/releases/latest/download/GeoLite2-City.mmdb"
TARGET_FILE="/root/GeoLite2-City.mmdb"
TMP_MMDB="/tmp/GeoLite2-City.mmdb.$$"

echo "[*] Checking connectivity..."
if ! curl -s --connect-timeout 8 https://github.com >/dev/null; then
    echo "[!] GitHub unreachable. Aborting."
    exit 1
fi

echo "[*] Downloading latest GeoLite2 City database..."
if curl -k -sSL --connect-timeout 15 --max-time 180 -L "$GEO_URL" -o "$TMP_MMDB" && [ -s "$TMP_MMDB" ]; then

    # Sanity check – make sure we got a real database, not an HTML error page
    if grep -qiE 'html|not found|error|404|DOCTYPE' "$TMP_MMDB" 2>/dev/null; then
        rm -f "$TMP_MMDB"
        echo "[!] Received HTML/error page instead of database. Aborting."
        exit 1
    fi

    mv -f "$TMP_MMDB" "$TARGET_FILE"
    chmod 644 "$TARGET_FILE"
    echo "[SUCCESS] Updated: $TARGET_FILE"
else
    rm -f "$TMP_MMDB"
    echo "[!] Download failed."
    exit 1
fi
