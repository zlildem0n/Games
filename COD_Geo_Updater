#!/bin/sh
# ==============================================================================
# WEEKLY MAXMIND GEOLITE2 CITY BINARY UPDATER (UNIFI SYSTEM PARSING FIX)
# ==============================================================================
GEO_URL="https://git.io/GeoLite2-City.mmdb"
TARGET_DIR="/usr/share/dpi/geoip"
TARGET_FILE="GeoLite2-City.mmdb"

if ! curl -s --connect-timeout 5 https://github.com > /dev/null; then
    echo "[!] GitHub platform unreachable. Skipping scheduled database refresh."
    exit 1
fi

mkdir -p "$TARGET_DIR"
TMP_MMDB="/tmp/${TARGET_FILE}_new"

if curl -k -sSL "$GEO_URL" -o "$TMP_MMDB" && [ -s "$TMP_MMDB" ]; then
    if grep -q "html" "$TMP_MMDB" 2>/dev/null || grep -q "Not Found" "$TMP_MMDB" 2>/dev/null; then
        rm -f "$TMP_MMDB"
        echo "[!] Error: Captured an HTML error payload instead of binary data. Aborting sync."
        exit 1
    fi

    # Force overwrite straight into the real UniFi OS DPI mapping layout directory
    mv -f "$TMP_MMDB" "${TARGET_DIR}/${TARGET_FILE}"
    chmod 644 "${TARGET_DIR}/${TARGET_FILE}"
    echo "[SUCCESS] Global UniFi OS native system GeoIP maps successfully updated: ${TARGET_DIR}/${TARGET_FILE}"
else
    rm -f "$TMP_MMDB"
    echo "[!] Error: Failed to fetch binary payload from source repository."
    exit 1
fi
