#!/bin/sh
# ==============================================================================
# WEEKLY MAXMIND GEOLITE2 UPDATER (KEPT YOUR DOWNLOAD METHOD)
# ==============================================================================
GEO_URL="https://github.com/P3TERX/GeoLite.mmdb/releases/download/2026.10.13/GeoLite2-City.mmdb"
TARGET_DIR="/root/GeoLite2-City.mmdb"
TARGET_FILE="GeoLite2-City.mmdb"

echo "[*] Checking connectivity..."
if ! curl -s --connect-timeout 8 https://github.com >/dev/null; then
    echo "[!] GitHub unreachable. Aborting."
    exit 1
fi

mkdir -p "$TARGET_DIR"
TMP_MMDB="/tmp/${TARGET_FILE}.$$"

echo "[*] Downloading GeoLite2 database..."
if curl -k -sSL --connect-timeout 15 --max-time 120 "$GEO_URL" -o "$TMP_MMDB" && [ -s "$TMP_MMDB" ]; then
    # Basic sanity check
    if grep -qiE 'html|not found|error|404' "$TMP_MMDB" 2>/dev/null; then
        rm -f "$TMP_MMDB"
        echo "[!] Received HTML/error page instead of binary database."
        exit 1
    fi

    # Optional: check magic (MaxMind DBs start with specific bytes, but keep it simple)
    mv -f "$TMP_MMDB" "${TARGET_DIR}/${TARGET_FILE}"
    chmod 644 "${TARGET_DIR}/${TARGET_FILE}"
    echo "[SUCCESS] Updated: ${TARGET_DIR}/${TARGET_FILE}"
else
    rm -f "$TMP_MMDB"
    echo "[!] Download failed."
    exit 1
fi
