#!/bin/sh
# ==============================================================================
# UNIVERSAL CONSOLE PORT WATCHER - ULTRA-LIGHTWEIGHT CRASH-PROOF BUILD
# ==============================================================================

# CONSOLE TARGET PROFILES
XBOX1_PORT="49806"
XBOX2_PORT="49290"

SCAN_SCRIPT="/root/cod_mass_scan.sh"
LOCK_FILE="/tmp/cod_scan.lock"
MASTER_FILE="/root/COD_Master.txt"
DUMP_FILE="/root/COD_Dump.txt"

# Clean out old lock configurations on initialization
rm -f "$LOCK_FILE"

echo "[*] COD Live Port Sensor Active. Monitoring LAN ports..."

# Taps the local bridge. Snaps awake if either Xbox fires outbound gaming data
tcpdump -ni br0 -n -l "udp and (sport $XBOX1_PORT or sport $XBOX2_PORT)" 2>/dev/null | while read -r tripwire_packet; do
    
    # Check if a scanning session is already handling a workload
    if [ ! -f "$LOCK_FILE" ]; then
        
        # If your master history list has entries, stage them for an absolute forced audit
        if [ -s "$MASTER_FILE" ]; then
            touch "$LOCK_FILE"
            echo "[!] Target gaming traffic detected! Initializing forced master list scan..."
            
            # Extract clean subnets out of your historical database into your triage mailbox
            awk '{print $1}' "$MASTER_FILE" > "$DUMP_FILE"
            
            # Execute your public IPv4-bound scanning script directly
            "$SCAN_SCRIPT"
            
            # Enforce a 15-second fast-reset gate lock to prevent duplicate loops
            (
                sleep 15
                rm -f "$LOCK_FILE"
                echo "[*] Scanner gate reset. Ready for next search queue."
            ) &
        fi
    fi
done
