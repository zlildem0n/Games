#!/bin/sh
# ==============================================================================
# DUAL-DIRECTION WAN IP & PORT COD WATCHER - PRODUCTION BUILD
# ==============================================================================

XBOX1_PORT="49806"
XBOX2_PORT="49290"
STUN_PORT="3074"
TARGET_NET="185.34.107.0/24"
PUBLIC_WAN_IP="24.229.189.181"

SCAN_SCRIPT="/root/cod_mass_scan.sh"
LOCK_FILE="/tmp/cod_scan.lock"
MASTER_FILE="/root/COD_Master.txt"
DUMP_FILE="/root/COD_Dump.txt"

# Clean out old lock configurations on initialization
rm -f "$LOCK_FILE"

echo "[*] COD WAN IP & Port Watcher Active. Monitoring via Corrected Flag Syntax..."

# FIXED TRIPWIRE LINK: Anchored strictly onto your Public WAN IP and mapped console ports
tcpdump -n -i any -l "udp and (
    (src host $PUBLIC_WAN_IP and (sport $XBOX1_PORT or sport $XBOX2_PORT) and dst net $TARGET_NET and dst port $STUN_PORT) or 
    (src net $TARGET_NET and src port $STUN_PORT and dst host $PUBLIC_WAN_IP and (dport $XBOX1_PORT or dport $XBOX2_PORT))
)" 2>/dev/null | while read -r tripwire_packet; do
    
    # Check if a scanning session is already handling a workload
    if [ ! -f "$LOCK_FILE" ]; then
        if [ -s "$MASTER_FILE" ]; then
            touch "$LOCK_FILE"
            echo "[!] Matchmaker Signature Caught! Initializing public IPv4 master scan..."
            
            # Extract clean subnets out of your historical database into your triage mailbox
            awk '{print $1}' "$MASTER_FILE" > "$DUMP_FILE"
            
            # Execute your public IPv4-bound scanning script directly
            "$SCAN_SCRIPT"
            
            # Enforce a 15-second fast-reset gate lock to prevent duplicate loops
            (
                sleep 15
                rm -f "$LOCK_FILE"
                echo "[*] Scanner gate reset. Ready for next search queue."
            ) &
        fi
    fi
done
