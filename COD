cat << 'EOF' > /root/cod_watcher.sh
#!/bin/sh
# ==============================================================================
# SINGLE-XBOX TARGETED WAN TRIPWIRE (EXPLICIT PORT MONITOR)
# ==============================================================================

XBOX_PORT="49806"
TARGET_NET="185.34.107.128"
PUBLIC_WAN_IP="24.229.189.181"

SCAN_SCRIPT="/root/cod_mass_scan.sh"
LOCK_FILE="/tmp/cod_scan.lock"
MASTER_FILE="/root/COD_Master.txt"
DUMP_FILE="/root/COD_Dump.txt"

# Clean out old lock configurations on initialization
rm -f "$LOCK_FILE"

echo "[*] COD Targeted WAN Engine Active. Monitoring Xbox 1 on Port $XBOX_PORT..."

# PINPOINT FILTER: Matches your exact working manual tcpdump capture footprint
tcpdump -n -i eth4 -l "udp and src host $PUBLIC_WAN_IP and sport $XBOX_PORT or UDP dst net $PUBLIC_WAN_IP" and dport $XBOX_PORT 2>/dev/null | while read -r tripwire_packet; do
    
    # Check if a scanning session is already handling a workload
    if [ ! -f "$LOCK_FILE" ]; then
        if [ -s "$MASTER_FILE" ]; then
            touch "$LOCK_FILE"
            echo "[!] Target Hit: Xbox 1 Matchmaker Heartbeat Caught on eth4!"
            
            # Extract clean subnets out of your historical database into your triage mailbox
            awk '{print $1}' "$MASTER_FILE" > "$DUMP_FILE"
            
            # Execute your public IPv4-bound scanning script directly
            "$SCAN_SCRIPT"
            
            # Enforce a 15-second fast-reset gate lock to match the heartbeat cadence
            (
                sleep 15
                rm -f "$LOCK_FILE"
                echo "[*] Scanner gate reset. Ready for next search queue."
            ) &
        fi
    fi
done
EOF
