#!/bin/sh
# ==============================================================================
# SCRIPT 5: PIPELINE MONITOR (IMPROVED)
# ==============================================================================
DUMP="/root/COD_Dump.txt"
PRE="/root/COD_Pre_Pending.txt"
PEND="/root/COD_Pending.txt"
POST="/root/COD_Post_Pending.txt"
BLOCK="/root/COD_Blocked.txt"
MAST="/root/COD_Master.txt"

status() {
    if pgrep -f "$1" >/dev/null 2>&1; then
        printf "\033[0;32mONLINE\033[0m"
    else
        printf "\033[0;31mOFFLINE\033[0m"
    fi
}

count_lines() {
    [ -f "$1" ] && wc -l < "$1" 2>/dev/null | tr -d ' ' || echo 0
}

clear
while true; do
    printf "\033[H"
    echo "================================================================================"
    echo "         CALL OF DUTY 5-STAGE PIPELINE MONITOR"
    echo "================================================================================"
    echo " TIME : $(date '+%Y-%m-%d %H:%M:%S')"
    echo "--------------------------------------------------------------------------------"
    printf "  Watcher          : %s\n" "$(status cod_watcher.sh)"
    printf "  Geo Scanner      : %s\n" "$(status cod_geo_scanner.sh)"
    printf "  Handshake Promoter: %s\n" "$(status cod_promoter.sh)"
    printf "  Volume Filter    : %s\n" "$(status cod_volume_filter.sh)"
    echo "--------------------------------------------------------------------------------"
    echo "  Stage 1 Dump          : $(count_lines "$DUMP") IPs"
    echo "  Stage 2 Pre-Pending   : $(count_lines "$PRE") IPs"
    echo "  Stage 3 Pending       : $(count_lines "$PEND") IPs"
    echo "  Stage 4 Post-Pending  : $(count_lines "$POST") /24 blocks"
    echo "  Blocked               : $(count_lines "$BLOCK") /24 blocks"
    echo "  Master History        : $(count_lines "$MAST") entries"
    echo "================================================================================"
    sleep 2
done
