#!/bin/sh
# ==============================================================================
# SCRIPT 8: SCOREBOARD PANEL MONITOR (CLEAN 5-STAGE PIPELINE MATRIX - V4.0)
# ==============================================================================
DUMP="/root/COD_Dump.txt"
PRE="/root/COD_Pre_Pending.txt"
PEND="/root/COD_Pending.txt"
POST="/root/COD_Post_Pending.txt"
BLOCK="/root/COD_Blocked.txt"
MAST="/root/COD_Master.txt"

clear
while true; do
    # Resets the terminal cursor back to the absolute top-left corner dynamically
    printf "\033[H"
    
    # High-efficiency file line evaluation execution blocks
    cnt_dump=$(wc -l "$DUMP" 2>/dev/null | awk '{print $1}')
    cnt_pre=$(wc -l "$PRE" 2>/dev/null | awk '{print $1}')
    cnt_pend=$(wc -l "$PEND" 2>/dev/null | awk '{print $1}')
    cnt_post=$(wc -l "$POST" 2>/dev/null | awk '{print $1}')
    cnt_block=$(wc -l "$BLOCK" 2>/dev/null | awk '{print $1}')
    cnt_mast=$(wc -l "$MAST" 2>/dev/null | awk '{print $1}')

    # Dynamic run-state validation check gates
    stat_w=$(pgrep -f "cod_watcher.sh" >/dev/null && echo "\033[0;32mONLINE\033[0m" || echo "\033[0;31mOFFLINE\033[0m")
    stat_g=$(pgrep -f "cod_geo_scanner.sh" >/dev/null && echo "\033[0;32mONLINE\033[0m" || echo "\033[0;31mOFFLINE\033[0m")
    stat_p=$(pgrep -f "cod_promoter.sh" >/dev/null && echo "\033[0;32mONLINE\033[0m" || echo "\033[0;31mOFFLINE\033[0m")
    stat_v=$(pgrep -f "cod_volume_filter.sh" >/dev/null && echo "\033[0;32mONLINE\033[0m" || echo "\033[0;31mOFFLINE\033[0m")

    echo "================================================================================"
    echo "         🛡️  CALL OF DUTY HIGH-SPEED 5-STAGE PIPELINE MONITOR 🛡️          "
    echo "================================================================================"
    echo " TIME SNAPSHOT : $(date '+%Y-%m-%d %H:%M:%S')"
    echo "--------------------------------------------------------------------------------"
    echo "  ⚙️  BACKGROUND DAEMON RUN-STATES:"
    printf "  • Watcher Sniper Engine : %s | • Geo Scanner Filter (S2) : %s\n" "$stat_w" "$stat_g"
    printf "  • Handshake Promoter(S3): %s | • Volume 10K Filter (S4)  : %s\n" "$stat_p" "$stat_v"
    echo "--------------------------------------------------------------------------------"
    echo "  [+] STAGE 1: Live Snipped Queue (COD_Dump.txt)          : ${cnt_dump:-0} IPs"
    echo "  [+] STAGE 2: Allowed Geolocation (COD_Pre_Pending.txt)  : ${cnt_pre:-0} IPs"
    echo "  [+] STAGE 3: Handshake Verified (COD_Pending.txt)      : ${cnt_pend:-0} IPs"
    echo "--------------------------------------------------------------------------------"
    echo "  📊 VALIDATION MATRICES & PROMOTIONS:"
    printf "  🟢 Stage 4 Approved Optimal   (COD_Post_Pending.txt)    : \033[0;32m%s /24 Blocks\033[0m\n" "${cnt_post:-0}"
    printf "  ❌ Distant Region Exclusions  (COD_Blocked.txt)         : \033[0;31m%s /24 Blocks\033[0m\n" "${cnt_block:-0}"
    echo "--------------------------------------------------------------------------------"
    echo "  🏢 Stage 5 Master History Pool (COD_Master.txt)         : ${cnt_mast:-0} Total Entries"
    echo "================================================================================"
    sleep 2
done
