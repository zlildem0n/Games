#!/bin/sh
# ==============================================================================
# SCRIPT 4: LATENCY ENGINE - LOCAL MAXMIND + CLOUD QUORUM DUAL-STAGE PROCESSOR
# ==============================================================================
MASTER_FILE="/root/COD_Master.txt"
US_ONLY_FILE="/root/COD_US_Only.txt"
LOW_LAT_POOL="/root/COD_Pending.txt"
HIGH_LAT_POOL="/root/COD_Blocked.txt"
OFFICIAL_POOL="/root/COD_Official_Allowed.txt"
PROMOTER_SCRIPT="/root/cod_promoter.sh"

touch "$MASTER_FILE" "$US_ONLY_FILE" "$LOW_LAT_POOL" "$HIGH_LAT_POOL" "$OFFICIAL_POOL"

while true; do
    # --- PHASE 1: GEOGATE INCOMING RUNNING HITS VIA LOCAL + CLOUD FAILOVER ---
    conntrack -L -p udp 2>/dev/null | grep "ASSURED" | grep "192.168.1.15" | grep "port=49806" | while read -r state_line; do
        SERVER_IP=$(echo "$state_line" | grep -oE 'dst=[0-9.]+' | awk -F= '{print $2}' | head -n1)
        [ -z "$SERVER_IP" ] && continue
        echo "$SERVER_IP" | grep -qE "^(192\.168|127\.)" && continue
        grep -q "$SERVER_IP" "$MASTER_FILE" && continue

        IS_US=0
        
        # Primary check using Local MaxMind (Fast Offline Scan)
        if command -v mmdblookup >/dev/null 2>&1; then
            LOCAL_CC=$(mmdblookup --ip "$SERVER_IP" --id country iso_code 2>/dev/null | grep -oE '"[A-Z]{2}"' | tr -d '"')
            [ "$LOCAL_CC" = "US" ] && IS_US=1
        elif command -v geoiplookup >/dev/null 2>&1; then
            LOCAL_CC=$(geoiplookup "$SERVER_IP" 2>/dev/null | grep -oE 'GeoIP Country Edition: [A-Z]{2}' | awk '{print $4}')
            [ "$LOCAL_CC" = "US" ] && IS_US=1
        fi

        # Failover Check: If local database flags it out-of-country, check the 2 APIs
        if [ "$IS_US" -eq 0 ]; then
            CLOUD_VOTES=0
            
            # API 1: freeipapi.com
            GEO_DATA=$(curl -s "https://freeipapi.com{SERVER_IP}" --max-time 3)
            [ "$(echo "$GEO_DATA" | grep -oE '"countryCode":"[^"]+"' | cut -d'"' -f4)" = "US" ] && CLOUD_VOTES=$%7BCLOUD_VOTES + 1%7D
            
            # API 2: ipinfo.io
            IPINFO_DATA=$(curl -s "https://ipinfo.io{SERVER_IP}/json" --max-time 3)
            [ "$(echo "$IPINFO_DATA" | grep -oE '"country": "[^"]+"' | cut -d'"' -f4)" = "US" ] && CLOUD_VOTES=$%7BCLOUD_VOTES + 1%7D

            # Both cloud APIs must verify US territory to rescue the IP
            [ "$CLOUD_VOTES" -eq 2 ] && IS_US=1
        fi

        if [ "$IS_US" -eq 1 ]; then
            echo "$SERVER_IP" >> "$US_ONLY_FILE"
            sort -u "$US_ONLY_FILE" -o "$US_ONLY_FILE"
        else
            echo "$SERVER_IP" >> "$HIGH_LAT_POOL"
            echo "$SERVER_IP #Blocked" >> "$MASTER_FILE"
        fi
    done

    # --- PHASE 2: INSPECT US ONLY POOL FOR EXACT 12 PACKETS OR 666 PACKETS ---
    if [ -s "$US_ONLY_FILE" ]; then
        conntrack -L -p udp 2>/dev/null | grep "ASSURED" | while read -r state_line; do
            PKT_COUNT=$(echo "$state_line" | grep -oE 'packets=[0-9]+' | awk -F= '{print $2}' | head -n1)
            [ -z "$PKT_COUNT" ] && continue
            
            if [ "$PKT_COUNT" -eq 12 ] || [ "$PKT_COUNT" -eq 666 ]; then
                TARGET_IP=$(echo "$state_line" | grep -oE 'dst=[0-9.]+' | awk -F= '{print $2}' | head -n1)
                if grep -q "^$TARGET_IP" "$US_ONLY_FILE" 2>/dev/null; then
                    sed -i "\|^$TARGET_IP|d" "$US_ONLY_FILE" 2>/dev/null
                    echo "$TARGET_IP" >> "$LOW_LAT_POOL"
                    echo "$TARGET_IP #Pending" >> "$MASTER_FILE"
                fi
            fi
        done
    fi

    # --- PHASE 3: VOLUME CHECKSTAGE FOR ESTABLISHED DATA (>10,000 BYTES) ---
    if [ -s "$LOW_LAT_POOL" ]; then
        conntrack -L -p udp 2>/dev/null | grep "ASSURED" | while read -r state_line; do
            BYTE_COUNT=$(echo "$state_line" | grep -oE 'bytes=[0-9]+' | awk -F= '{print $2}' | head -n1)
            [ -z "$BYTE_COUNT" ] || [ "$BYTE_COUNT" -lt 10000 ] && continue
            
            PENDING_IP=$(echo "$state_line" | grep -oE 'dst=[0-9.]+' | awk -F= '{print $2}' | head -n1)
            if grep -q "^$PENDING_IP" "$LOW_LAT_POOL" 2>/dev/null; then
                if [ -x "$PROMOTER_SCRIPT" ]; then "$PROMOTER_SCRIPT" & fi
            fi
        done
    fi

    sort -u "$MASTER_FILE" -o "$MASTER_FILE" 2>/dev/null
    sort -u "$LOW_LAT_POOL" -o "$LOW_LAT_POOL" 2>/dev/null
    sort -u "$HIGH_LAT_POOL" -o "$HIGH_LAT_POOL" 2>/dev/null
    sleep 5
done

