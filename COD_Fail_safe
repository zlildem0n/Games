#!/bin/sh
MAX_LATENCY=70
MASTER_FILE="/root/COD_Master.txt"
LOW_LAT_POOL="/root/COD_Pending.txt"
HIGH_LAT_POOL="/root/COD_Blocked.txt"
PROMOTER_SCRIPT="/root/cod_promoter.sh"

touch "$MASTER_FILE" "$LOW_LAT_POOL" "$HIGH_LAT_POOL"

while true; do
    conntrack -L -p udp 2>/dev/null | grep "ASSURED" | grep "192.168.1.15" | grep "port=49806" | while read -r state_line; do
        BYTE_COUNT=$(echo "$state_line" | grep -oE 'bytes=[0-9]+' | awk -F= '{print $2}' | head -n1)
        [ -z "$BYTE_COUNT" ] || [ "$BYTE_COUNT" -lt 10000 ] && continue
        
        SERVER_IP=$(echo "$state_line" | grep -oE 'dst=[0-9.]+' | awk -F= '{print $2}' | head -n1)
        [ -z "$SERVER_IP" ] && continue
        echo "$SERVER_IP" | grep -qE "^(192\.168|127\.)" && continue
        
        # STUN & TEREDO MASTER EXCEPTION GATE: Force-whitelist core infrastructure nodes
        case "$SERVER_IP" in
            185.34.107.*|65.54.227.120|24.229.189.181)
                if ! grep -q "$SERVER_IP" "$MASTER_FILE" 2>/dev/null; then
                    echo "$SERVER_IP" >> "$LOW_LAT_POOL"
                    echo "$SERVER_IP #Pending" >> "$MASTER_FILE"
                    if [ -x "$PROMOTER_SCRIPT" ]; then "$PROMOTER_SCRIPT" & fi
                fi
                continue
                ;;
        esac

        grep -q "$SERVER_IP" "$MASTER_FILE" && continue

        GEO_DATA=$(curl -s "https://freeipapi.com{SERVER_IP}" --max-time 3)
        REGION_CODE=$(echo "$GEO_DATA" | grep -oE '"regionCode":"[^"]+"' | cut -d'"' -f4)
        COUNTRY_CODE=$(echo "$GEO_DATA" | grep -oE '"countryCode":"[^"]+"' | cut -d'"' -f4)

        IS_EAST_COAST=0
        if [ "$COUNTRY_CODE" = "US" ]; then
            case "$REGION_CODE" in
                IL|NY|VA|GA|FL|NJ|PA|MA|MD|NC) IS_EAST_COAST=1 ;;
            esac
        fi

        if [ "$IS_EAST_COAST" -eq 1 ]; then
            WAN_IP=$(ip -4 route get 1.1.1.1 2>/dev/null | grep -oE 'src [0-9.]+' | awk '{print $2}')
            [ -z "$WAN_IP" ] && WAN_IP="0.0.0.0"
            
            PING_STAT=$(ping -4 -I "$WAN_IP" -c 2 -W 1 "$SERVER_IP" 2>/dev/null | grep avg)
            if [ -z "$PING_STAT" ]; then
                GATEWAY_IP=$(echo "$SERVER_IP" | awk -F. '{print $1"."$2"."$3".1"}')
                PING_STAT=$(ping -4 -I "$WAN_IP" -c 2 -W 1 "$GATEWAY_IP" 2>/dev/null | grep avg)
            fi
            
            PING_TIME=$(echo "$PING_STAT" | awk -F/ '{print $5}' | cut -d. -f1)
            
            if [ -n "$PING_TIME" ] && [ "$PING_TIME" -le "$MAX_LATENCY" ]; then
                echo "$SERVER_IP" >> "$LOW_LAT_POOL"
                echo "$SERVER_IP #Pending" >> "$MASTER_FILE"
                if [ -x "$PROMOTER_SCRIPT" ]; then "$PROMOTER_SCRIPT" & fi
            else
                echo "$SERVER_IP" >> "$HIGH_LAT_POOL"
                echo "$SERVER_IP #Blocked" >> "$MASTER_FILE"
            fi
        else
            echo "$SERVER_IP" >> "$HIGH_LAT_POOL"
            echo "$SERVER_IP #Blocked" >> "$MASTER_FILE"
        fi
    done
    
    sort -u "$MASTER_FILE" -o "$MASTER_FILE" 2>/dev/null
    sort -u "$LOW_LAT_POOL" -o "$LOW_LAT_POOL" 2>/dev/null
    sort -u "$HIGH_LAT_POOL" -o "$HIGH_LAT_POOL" 2>/dev/null
    sleep 5
done
