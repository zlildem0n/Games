cat << 'EOF' > /root/cod_failsafe.sh
#!/bin/sh
# ==============================================================================
# SCRIPT 4: LATENCY ENGINE - TWO-TIER PORT RANGE ELEVATION CORE
# ==============================================================================
MASTER_FILE="/root/COD_Master.txt"
DUMP_FILE="/root/COD_Dump.txt"
US_ONLY_FILE="/root/COD_US_Only.txt"
LOW_LAT_POOL="/root/COD_Pending.txt"
HIGH_LAT_POOL="/root/COD_Blocked.txt"
OFFICIAL_POOL="/root/COD_Official_Allowed.txt"
PROMOTER_SCRIPT="/root/cod_promoter.sh"

touch "$MASTER_FILE" "$DUMP_FILE" "$US_ONLY_FILE" "$LOW_LAT_POOL" "$HIGH_LAT_POOL" "$OFFICIAL_POOL"

# Native utility tool to verify if a port falls inside the 30000:45000 block
port_in_range() {
    local chk_port=$1
    if [ "$chk_port" -ge 30000 ] && [ "$chk_port" -le 45000 ]; then return 0; fi
    return 1
}

while true; do
    # --- PHASE 1: PROCESS DUMP MAILBOX THROUGH 2/3 US COUNTRY QUORUM ---
    if [ -s "$DUMP_FILE" ]; then
        _queue="/tmp/cod_failsafe_queue.txt"
        mv "$DUMP_FILE" "$_queue" && touch "$DUMP_FILE"
        
        while read -r SERVER_IP; do
            [ -z "$SERVER_IP" ] && continue
            grep -q "$SERVER_IP" "$MASTER_FILE" && continue
            
            VOTES_PASSED=0
            GEO_DATA=$(curl -s "https://freeipapi.com{SERVER_IP}" --max-time 2)
            [ "$(echo "$GEO_DATA" | grep -oE '"countryCode":"[^"]+"' | cut -d'"' -f4)" = "US" ] && VOTES_PASSED=$((VOTES_PASSED + 1))
            
            IPINFO_DATA=$(curl -s "https://ipinfo.io{SERVER_IP}/json" --max-time 2)
            [ "$(echo "$IPINFO_DATA" | grep -oE '"country": "[^"]+"' | cut -d'"' -f4)" = "US" ] && VOTES_PASSED=$((VOTES_PASSED + 1))

            if [ "$VOTES_PASSED" -lt 2 ]; then
                if command -v mmdblookup >/dev/null 2>&1; then
                    LOCAL_CC=$(mmdblookup --ip "$SERVER_IP" --id country iso_code 2>/dev/null | grep -oE '"[A-Z]{2}"' | tr -d '"')
                    [ "$LOCAL_CC" = "US" ] && VOTES_PASSED=$((VOTES_PASSED + 1))
                fi
            fi

            if [ "$VOTES_PASSED" -ge 2 ]; then
                echo "$SERVER_IP" >> "$US_ONLY_FILE"
            else
                echo "$SERVER_IP" >> "$HIGH_LAT_POOL"
                echo "$SERVER_IP #Blocked" >> "$MASTER_FILE"
            fi
        done < "$_queue"
        rm -f "$_queue"
        sort -u "$US_ONLY_FILE" -o "$US_ONLY_FILE"
    fi

    # --- PHASE 2: AUDIT US ONLY TRAFFIC FOR PORT CONDITIONS (BURIED TO PENDING OR ALLOWED) ---
    if [ -s "$US_ONLY_FILE" ]; then
        conntrack -L -p udp 2>/dev/null | grep "ASSURED" | grep "192.168.1.15" | while read -r state_line; do
            # Core parameter check: All target lanes must carry your unique Xbox port 49806
            echo "$state_line" | grep -q "port=49806" || continue
            
            TARGET_IP=$(echo "$state_line" | grep -oE 'dst=[0-9.]+' | awk -F= '{print $2}' | head -n1)
            grep -q "^$TARGET_IP" "$US_ONLY_FILE" || continue

            DPORT=$(echo "$state_line" | grep -oE 'dport=[0-9]+' | awk -F= '{print $2}' | head -n1)
            SPORT=$(echo "$state_line" | grep -oE 'sport=[0-9]+' | awk -F= '{print $2}' | head -n1)
            
            # ROUTING CONDITION 1: Ports 3074 or 3544 go STRAIGHT to Allowed Whitelist
            if [ "$DPORT" = "3074" ] || [ "$DPORT" = "3544" ] || [ "$SPORT" = "3074" ] || [ "$SPORT" = "3544" ]; then
                sed -i "\|^$TARGET_IP|d" "$US_ONLY_FILE" 2>/dev/null
                SUBNET=$(echo "$TARGET_IP" | awk -F. '{print $1"."$2"."$3".0/24"}')
                echo "$SUBNET" >> "$OFFICIAL_POOL"
                echo "$SUBNET #Official_Allowed" >> "$MASTER_FILE"
                continue
            fi

            # ROUTING CONDITION 2: Block 30000:45000 drops into Pending folder to gather volume history
            if port_in_range "$DPORT" || port_in_range "$SPORT"; then
                sed -i "\|^$TARGET_IP|d" "$US_ONLY_FILE" 2>/dev/null
                echo "$TARGET_IP" >> "$LOW_LAT_POOL"
                echo "$TARGET_IP #Pending" >> "$MASTER_FILE"
                continue
            fi
        done
    fi

    # --- PHASE 3: TELEMETRY LOAD AUDIT FOR PENDING POOL DATA (>10,000 BYTES) ---
    if [ -s "$LOW_LAT_POOL" ]; then
        conntrack -L -p udp 2>/dev/null | grep "ASSURED" | while read -r state_line; do
            BYTE_COUNT=$(echo "$state_line" | grep -oE 'bytes=[0-9]+' | awk -F= '{print $2}' | head -n1)
            [ -z "$BYTE_COUNT" ] || [ "$BYTE_COUNT" -lt 10000 ] && continue
            
            PENDING_IP=$(echo "$state_line" | grep -oE 'dst=[0-9.]+' | awk -F= '{print $2}' | head -n1)
            if grep -q "^$PENDING_IP" "$LOW_LAT_POOL" 2>/dev/null; then
                # Target range passed both port filtering and byte load benchmarks -> Trigger Promotion
                if [ -x "$PROMOTER_SCRIPT" ]; then "$PROMOTER_SCRIPT" & fi
            fi
        done
    fi

    sort -u "$MASTER_FILE" -o "$MASTER_FILE" 2>/dev/null
    sort -u "$LOW_LAT_POOL" -o "$LOW_LAT_POOL" 2>/dev/null
    sort -u "$HIGH_LAT_POOL" -o "$HIGH_LAT_POOL" 2>/dev/null
    sleep 5
done
EOF
sed -i 's/\r//g' /root/cod_failsafe.sh && chmod 755 /root/cod_failsafe.sh


